# --- 자격증명 (절대 커밋 금지) ---
# 실값이 담긴 .env 는 커밋하지 않고, 키 목록은 sample.env 로만 관리한다 (docs/rules/개발규칙.md 그라운드 룰 6)
.env
.env.*
!sample.env
!.env.example
*.session
*.session-journal
*.pem
*.key
*.p12
*.pfx
*.credentials
*.token

# --- 외부 벤더 클론 (Telethon 세션·자격증명 포함) ---
vendor/

# --- 런타임 (상태·로그·산출물). 통째로 제외한다 ---
var/

# --- 캐시 / 빌드 산출물 ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
venv/
.venv/

# --- 에이전트 로컬 설정 ---
.claude/settings.local.json
.claude/settings.local.json.tmp.*

# --- 일회성 작업 스크립트 ---
scratch/
