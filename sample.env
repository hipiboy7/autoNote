# =============================================================================
# autoNote 환경변수 샘플
#
# 사용법:  cp sample.env .env  후 실제 값 입력
#
# 규칙 (docs/rules/개발규칙.md 그라운드 룰 6·7):
#   - 실값이 담긴 .env 는 절대 커밋하지 않는다 (.gitignore 등록됨).
#   - .env 에 키를 추가/삭제/이름변경하면 같은 커밋에서 이 파일도 함께 갱신한다.
#   - 이 파일에는 **코드가 실제로 읽는 키만** 등재한다.
#
# LLM 은 Antigravity(agy) 워커로 실행하므로 **OpenAI API 키가 필요하지 않다.**
# 모델 구성은 packages/app/src/autonote/worker_roster.py 가 단일 출처이고, 아래 키로 덮어쓴다.
# =============================================================================

# --- agy 워커 로스터 오버라이드 ------------------------------------------------
# 미지정 시 worker_roster.py 의 실측 기반 기본값을 쓴다.
# 사용 가능한 모델은 `agy models` 로 확인한다.
#   기본값: triage=gemini-3.5-flash-medium  extract=gemini-3.1-pro-high
#           review=claude-opus-4-6-thinking repair=gemini-3.5-flash-medium
# 주의: gpt-oss-120b-medium 은 토큰 15배·오분류로 사용 금지.
AGY_WORKER_TRIAGE_MODEL=
AGY_WORKER_TRIAGE_BATCH_SIZE=
AGY_WORKER_TRIAGE_TIMEOUT_SECONDS=

AGY_WORKER_EXTRACT_MODEL=
AGY_WORKER_EXTRACT_EFFORT=
AGY_WORKER_EXTRACT_BATCH_SIZE=
AGY_WORKER_EXTRACT_TIMEOUT_SECONDS=

AGY_WORKER_REVIEW_MODEL=
AGY_WORKER_REVIEW_TIMEOUT_SECONDS=

AGY_WORKER_REPAIR_MODEL=
AGY_WORKER_REPAIR_BATCH_SIZE=

# --- agy CLI ------------------------------------------------------------------
ANTIGRAVITY_AGENTAPI_EXE=C:\Users\<USER>\AppData\Local\agy\bin\agy.exe
# 워커 호출 토큰 사용량 누적 기록 (배치 크기 튜닝 근거)
AGY_USAGE_LOG=./var/agy_usage.jsonl
# --mode review / --model 미지정 시 리뷰 워커 모델 기본값
AGY_REVIEW_MODEL=

# --- 분석 동작 파라미터 --------------------------------------------------------
# 원문 1건을 프롬프트에 실을 때의 최대 길이 (초과분은 잘라내고 표시)
ANALYZER_MAX_SOURCE_CHARS=2400
# 근거 검증 실패 시 재시도 횟수
ANALYZER_MAX_RETRIES=1

# --- 텔레그램 수집 -------------------------------------------------------------
TELEGRAM_CHANNEL_ID=-1004421517798
# Telegram MCP 서버 디렉터리 (세션·자격증명 보관 위치. Drive 동기화 제외 대상)
TELEGRAM_MCP_DIR=D:\autoNote\vendor\telegram-mcp

# --- 배치 이상 알림 ------------------------------------------------------------
# 0/false 로 두면 알림을 보내지 않는다 (테스트·디버깅용).
NOTIFY_ENABLED=1
# 알림 수신 대화. 기본 'me' = 본인 저장 메시지(Saved Messages) → 휴대폰 푸시.
# 다른 대화로 받으려면 채널/그룹 ID 를 넣는다.
NOTIFY_TELEGRAM_CHAT_ID=me
# 마지막 성공 배치가 이 시간을 넘기면 '배치가 안 돌았다'로 판정한다.
# 일일 배치(08:50) 기준 기본 26시간.
BATCH_MAX_AGE_HOURS=26

# --- 상태 파일 ----------------------------------------------------------------
# 채널별 마지막 처리 message_id, 주간리뷰 주차, 자동 생성 문서, 매핑 override 기록
STATE_FILE_PATH=./var/state.json

# --- Google Docs 문서 ID -------------------------------------------------------
# 미지정 시 main.py 의 현행 운영 문서 기본값이 사용된다.
THOUGHT_DOC_ID=
REVIEW_DOC_ID=

# 원문보관 — 기본(폴백) 문서 및 월별 매핑
ORIGINAL_DOC_ID=
# "YYYY-MM=docId" 를 콤마로 나열. 미등록 월은 배치가 '00_원문보관 YYYY-MM' 을
# 자동 생성해 state.json 의 original_docs 에 등록한다.
ORIGINAL_DOC_MONTHLY=
# 하위 호환용 (2026-08 문서)
ORIGINAL_DOC_08_ID=

# 테마 문서 — 키는 analyzer.THEMES 와 정확히 일치해야 한다 (기동 시 검증)
THEME_SEMI_DOC_ID=
THEME_SENTIMENT_DOC_ID=
THEME_MACRO_DOC_ID=
THEME_RATE_DOC_ID=
THEME_DEFENSE_DOC_ID=

# 종목 문서
STOCK_HANWHA_DOC_ID=
STOCK_AUBRANDS_DOC_ID=
STOCK_APR_DOC_ID=

# --- Google Drive -------------------------------------------------------------
# 자동 생성 문서 및 복구 문서를 옮겨 둘 폴더 (투자리서치노트_gemini)
DRIVE_PARENT_FOLDER_ID=
