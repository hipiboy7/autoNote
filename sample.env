# =============================================================================
# autoNote 환경변수 샘플
#
# 사용법:  cp sample.env .env  후 실제 값 입력
#
# 규칙 (program/gemini.md 그라운드 룰 6·7):
#   - 실값이 담긴 .env 는 절대 커밋하지 않는다 (.gitignore 등록됨).
#   - .env 에 키를 추가/삭제/이름변경하면 같은 커밋에서 이 파일도 함께 갱신한다.
#   - 코드는 generic alias(chat-llm / reasoning-llm)만 참조한다.
#     backend-specific 이름(OPENAI_*, VLLM_* 등)을 코드에 직접 박지 않는다.
#
# 이 파일에는 **코드가 실제로 읽는 키만** 등재한다.
# =============================================================================

# --- chat-llm : 일반 chat / 오케스트레이션 (Workflow A) -----------------------
# production: vLLM Qwen3-Coder 30B  |  test: OpenAI gpt-4o
# CHAT_LLM_MODEL 은 main.py 의 --model 기본값으로도 쓰인다.
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_MODEL=gpt-4o
CHAT_LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- reasoning-llm : 리서치 분석·추론 (Workflow B) ---------------------------
# production: vLLM GPT-OSS 130B  |  test: OpenAI o4-mini
# analyzer(핵심 논리 추출)와 reviewer(주간리뷰)가 이 백엔드를 사용한다.
REASONING_LLM_BASE_URL=https://api.openai.com/v1
REASONING_LLM_MODEL=o4-mini
REASONING_LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 상태 파일 경로 ----------------------------------------------------------
# 채널별 마지막 처리 message_id 및 마지막 실행 시각 기록 위치
STATE_FILE_PATH=./data/state.json

# --- Google Docs 문서 ID -----------------------------------------------------
# 미지정 시 main.py 의 하드코딩 기본값이 사용된다.
# 생각 입력 창구 (99_생각노트)
THOUGHT_DOC_ID=
# 주간리뷰 누적 문서 (40_리뷰)
REVIEW_DOC_ID=

# 원문보관 — 기본(폴백) 문서 및 월별 매핑
# ORIGINAL_DOC_ID 는 월별 매핑에 없는 달의 폴백으로 쓰인다.
ORIGINAL_DOC_ID=
# ORIGINAL_DOC_MONTHLY: "YYYY-MM=docId" 를 콤마로 나열.
# 새 달의 원문보관 문서를 만들면 이 값에 항목을 추가한다.
# 예: ORIGINAL_DOC_MONTHLY=2026-07=17b8iLt_...,2026-08=1gfyz-nJ...
ORIGINAL_DOC_MONTHLY=

# 테마 문서
THEME_SEMI_DOC_ID=
THEME_SENTIMENT_DOC_ID=
THEME_MACRO_DOC_ID=
THEME_RATE_DOC_ID=
THEME_DEFENSE_DOC_ID=

# 종목 문서
STOCK_HANWHA_DOC_ID=
STOCK_AUBRANDS_DOC_ID=
STOCK_APR_DOC_ID=

# --- Antigravity CLI ---------------------------------------------------------
# llm-gateway 의 폴백 경로에서 호출하는 실행 파일 경로
ANTIGRAVITY_AGENTAPI_EXE=C:\Users\<USER>\AppData\Local\agy\bin\agy.exe
# agy 폴백 호출 제한 시간(초). 미지정 시 120초.
ANTIGRAVITY_TIMEOUT_SECONDS=120
